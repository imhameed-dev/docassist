# Copy to ".env" (never commit .env). All variables are optional.
DOCASSIST_ENVIRONMENT=development
DOCASSIST_APP_NAME=Private AI Document Assistant

# Upload limits. PDFs are processed inside the upload request, so keep these modest.
DOCASSIST_MAX_UPLOAD_MB=20
DOCASSIST_MAX_PAGES=200

# Where uploaded PDFs and the default SQLite database are stored (default: <repo>/data).
# Use an absolute path.
# DOCASSIST_DATA_DIR=/home/you/docassist-data

# Optional: use PostgreSQL instead of the default SQLite file in the data directory.
# DOCASSIST_DATABASE_URL=postgresql+psycopg://user:password@localhost/docassist
